<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="${GL_VERSION_CODE}" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/icon2"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icon2"
        tools:targetApi="31">
        <activity
            android:name=".NativeLoader"
            android:configChanges="keyboardHidden|screenSize"
            android:screenOrientation="${APP_ORIENTATION}" android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:clearTaskOnLaunch="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.${APP_CATEGORY}" />
            </intent-filter>

            <meta-data
                android:name="android.app.lib_name"
                android:value="${APP_LIB_NAME}" />
        </activity>

    </application>

</manifest>
